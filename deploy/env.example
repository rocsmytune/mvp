# 生产部署环境变量模板。
# 1) 复制到仓库根目录并改名 .env：  cp deploy/env.example .env
# 2) 务必改掉下面两个 change-me 占位值！
# docker compose 会自动读取根目录 .env 做 ${VAR} 替换。

# ---- 数据库（db 容器）----
POSTGRES_USER=mvp
POSTGRES_DB=mvp
# 必改：数据库密码（随机强密码）
POSTGRES_PASSWORD=change-me

# ---- 后端 ----
# 必改：随机强密钥，>=32 字节，用 `openssl rand -hex 32` 生成
SECRET_KEY=change-me-to-a-random-secret-key

# ---- 前端对外端口 ----
# 默认 80；若服务器 80 被占用，改成其它（如 8080），浏览器访问 http://<ip>:8080
FRONTEND_PORT=80
